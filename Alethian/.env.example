# -----------------------------------------------------------------------------
# Alethian Environment Variables
# Copy this file to .env in Alethian/ and Alethian/infrastructure/
# -----------------------------------------------------------------------------

# PostgreSQL (User Data)
POSTGRES_USER=alethian
POSTGRES_PASSWORD=alethian_pass
POSTGRES_DB=alethian_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Task Queue & Cache)
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector Database)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# External APIs (Get keys from respective providers)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key
SERPER_API_KEY=your_serper_dev_key
UNPAYWALL_EMAIL=your_email@university.edu

# Application Security
# Generate a strong key: openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Processing Constraints
MAX_UPLOAD_SIZE_MB=100
MAX_DRAGNET_QUERIES=20
DRAGNET_RATE_LIMIT_RPM=60

# Auth Settings
ALLOW_AUTO_REGISTRATION=false

# Initial Admin User (Created on first run)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=admin_secure_password
