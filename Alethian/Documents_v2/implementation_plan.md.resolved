### A3. Wire Celery Worker to Persist All Records

#### [MODIFY] [celery_worker.py](file:///home/akshit/Projects/Plag-checkv1/Alethian/backend/celery_worker.py)

Replace dummy text with real Grobid extraction. Full pipeline:

```python
@celery_app.task(bind=True, name="analyze_document")
def analyze_document(self, document_id, file_path):
    db = SessionLocal()
    try:
        doc = db.query(Document).filter(...).first()
        doc.status = DocumentStatus.processing
        db.commit()

        # 1. INGESTION — Extract text via Grobid
        from app.core.ingestion import GrobidClient
        grobid = GrobidClient()
        with open(file_path, "rb") as f:
            processed = grobid.process_pdf(f.read())
        text = processed.get("body_text", "")
        doc.title = processed.get("title", doc.title)
        doc.author = processed.get("authors", doc.author)
        doc.meta_data = processed
        doc.page_count = processed.get("page_count", 0)
        db.commit()

        # 2. INTERNAL SIMILARITY
        internal_matches = run_similarity(document_id, text, db)

        # 3. WEB DRAGNET
        web_matches = run_dragnet(document_id, text, internal_matches)

        # 4. PERSIST SOURCES
        source_map = {}
        for m in internal_matches + web_matches:
            key = m.get("source_document_id") or m.get("url")
            if key not in source_map:
                src = Source(
                    type=m.get("type", "web"),
                    url=m.get("url"),
                    title=m.get("source_title"),
                    domain=m.get("domain"),
                    document_id=m.get("source_document_id"),
                )
                db.add(src)
                db.flush()
                source_map[key] = src.id

        # 5. PERSIST MATCHES
        for m in internal_matches + web_matches:
            key = m.get("source_document_id") or m.get("url")
            match_record = Match(
                report_id=report.id,
                source_id=source_map.get(key),
                type=m["type"],
                submitted_text=m["submitted_text"],
                source_text=m["source_text"],
                submitted_page=m.get("submitted_page"),
                source_page=m.get("source_page"),
                submitted_start_char=m.get("submitted_start_char"),
                submitted_end_char=m.get("submitted_end_char"),
                similarity=m["similarity_score"],
                match_length_words=len(m["submitted_text"].split()),
            )
            db.add(match_record)

        # 6. GENERATE REPORT + HEATMAP
        all_matches = internal_matches + web_matches
        score = calculate_originality(all_matches, len(text.split()))
        risk = "high" if score < 50 else ("moderate" if score < 80 else "low")

        report = Report(document_id=doc.id, score=score, risk_level=risk)
        db.add(report)
        db.flush()

        heatmap = generate_heatmap(all_matches, doc.page_count)
        for h in heatmap:
            hp = HeatmapPage(report_id=report.id, **h)
            db.add(hp)

        # 7. INDEX for future comparisons (FR-2.6)
        index_document(document_id, text)

        doc.status = DocumentStatus.complete
        db.commit()
    except Exception as e:
        ...  # set failed, raise
    finally:
        db.close()
```

